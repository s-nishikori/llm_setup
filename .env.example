# Hugging Face model repository. Choose a quantized model that fits your GPU.
MODEL_ID=REPLACE_WITH_HUGGING_FACE_MODEL_ID

# Persistent Vast.ai storage is commonly mounted below /workspace.
MODEL_DIR=/workspace/models/qwen
SERVED_MODEL_NAME=qwen

HOST=127.0.0.1
PORT=8000
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90
TENSOR_PARALLEL_SIZE=1

# Optional vLLM flags, for example: --quantization awq
VLLM_EXTRA_ARGS=

# Generate with: openssl rand -hex 32
VLLM_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Only required for gated/private Hugging Face repositories.
HF_TOKEN=
